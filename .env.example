# Set credentials locally; never commit your populated .env file.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
COT_MODEL=gpt-5.2
# Optional: an external checkout instead of ./scenesmith
# SCENESMITH_ROOT=./scenesmith
# Optional: Python with bpy installed (defaults to current Python).
# BLENDER_PYTHON=./scenesmith/.venv/bin/python
# SceneSmith backend credentials/assets follow upstream setup instructions.
CRITIC_JUDGE_MODEL=gpt-5.2
CRITIC_POLISH_MODEL=gpt-5.2
SCENESMITH_MODEL=gpt-5.2
SCENE_RENDER_THREADS=8
SCENE_RENDER_SAMPLES=24
