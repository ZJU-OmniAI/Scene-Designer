@@ -0,0 +1,468 @@
+"""Route OpenAI SDK + openai-agents SDK to a custom OpenAI-compatible gateway.
+
+Non-invasive: a single ``configure()`` call from ``main.py`` flips every
+``OpenAI()`` / ``AsyncOpenAI()`` and every ``agents.Agent`` to use a third-party
+endpoint (e.g. https://api.openai.com/v1). No-op unless ``SCENESMITH_LLM_BASE_URL``
+is set, so the default code path is unchanged.
+
+Includes a three-layer 429 survival kit:
+
+1. Request-level retry: ``max_retries`` on the openai client (honours
+   ``Retry-After`` / ``retry-after-ms`` headers internally).
+2. Connection-level throttle: a custom httpx transport that wraps a shared
+   concurrency semaphore around every outbound request. This is the real lever
+   against 429s because scenesmith runs many agents in parallel.
+3. Telemetry: a background counter that logs 429/5xx rates periodically so
+   flakiness is visible instead of hidden inside SDK retries.
+
+Env vars (all optional except base URL):
+
+    SCENESMITH_LLM_BASE_URL          Gateway base URL, e.g. https://api.openai.com/v1
+    SCENESMITH_LLM_API_KEY           API key (falls back to OPENAI_API_KEY)
+    SCENESMITH_LLM_MODE              "responses" (default) or "chat_completions"
+    SCENESMITH_LLM_MAX_RETRIES       Per-request retry cap (default 10)
+    SCENESMITH_LLM_MAX_CONCURRENCY   Global in-flight cap (default 8)
+    SCENESMITH_LLM_TIMEOUT_READ      Per-request read timeout seconds (default 180)
+    SCENESMITH_LLM_REASONING_MODELS  Comma list of extra reasoning models, e.g.
+                                     "gpt-5.4-mini,gpt-5.4-nano"
+    SCENESMITH_LLM_DISABLE_TRACING   "0" to keep Agents SDK tracing enabled
+                                     (default "1"; third-party gateways 404 it)
+    SCENESMITH_LLM_STRIP_TOOL_CHOICE "0" to disable the yunwu-style workaround
+                                     that rewrites object-form `tool_choice`
+                                     (e.g. ``{"type":"function","name":"x"}``)
+                                     to the string ``"required"`` before the
+                                     request leaves the client. yunwu/apiplus
+                                     etc. have a Go struct that types
+                                     `tool_choice` as string-only and returns
+                                     524 when upstream echoes the object form.
+                                     Default "1" (enabled).
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import threading
+import time
+
+from functools import lru_cache
+
+import httpx
+
+_log = logging.getLogger(__name__)
+
+# Flipped by configure() once it reads the env. We keep it as a module-level
+# toggle rather than a transport attribute so the same logic can be imported
+# from tests without constructing a transport.
+_strip_tool_choice: bool = True
+
+
+def _rewrite_request_body_for_yunwu(request: httpx.Request) -> None:
+    """In-place rewrite outgoing JSON body so yunwu-family gateways don't 524.
+
+    Problem: openai-agents SDK serialises ``tool_choice="some_function"`` as
+    ``{"type": "function", "name": "some_function"}`` (an object). OpenAI's
+    own API accepts this. yunwu/apiplus/etc. have a Go response parser whose
+    ``OpenAIResponsesResponse.tool_choice`` field is typed as ``string``, so
+    when upstream echoes the object back, the gateway crashes with
+    ``json: cannot unmarshal object into Go struct field ... tool_choice of
+    type string`` and returns HTTP 524. Every critic-agent request in
+    scenesmith hits this because ``_create_critic_agent`` forces the first
+    tool call via object form.
+
+    We degrade to the string ``"required"`` -- scenesmith only uses the
+    object form to *force* a tool call, and ``"required"`` forces *a* tool
+    call (the model will pick the intended one from context, just not
+    guaranteed). Scenesmith code is not touched.
+
+    Cheap prefilter on the raw bytes avoids JSON-parsing every request.
+    """
+    if not _strip_tool_choice:
+        return
+    try:
+        content = request.content
+    except Exception:  # pragma: no cover - streaming body, not our case
+        return
+    if b'"tool_choice"' not in content:
+        return
+    try:
+        body = json.loads(content)
+    except Exception:
+        return
+    if not isinstance(body, dict):
+        return
+    tc = body.get("tool_choice")
+    if not isinstance(tc, dict):
+        return
+
+    body["tool_choice"] = "required"
+    new_bytes = json.dumps(body).encode()
+    request.stream = httpx.ByteStream(new_bytes)
+    # httpx.Request caches its body as `_content` when constructed with `json=`
+    # or `content=`; swapping `stream` alone leaves `.content` returning the
+    # old bytes. Keep both in sync.
+    request._content = new_bytes  # type: ignore[attr-defined]
+    request.headers["content-length"] = str(len(new_bytes))
+
+# Shared across all openai clients in this process so concurrency caps are
+# global, not per-client.
+_async_sem: asyncio.Semaphore | None = None
+_sync_sem: threading.Semaphore | None = None
+_async_sem_lock = threading.Lock()
+
+# 429/5xx telemetry.
+_stats = {"total": 0, "429": 0, "5xx": 0, "last_log_ts": 0.0}
+_stats_lock = threading.Lock()
+
+
+def _get_async_sem(limit: int) -> asyncio.Semaphore:
+    """Lazy-create the async semaphore on first use inside an event loop."""
+    global _async_sem
+    if _async_sem is None:
+        with _async_sem_lock:
+            if _async_sem is None:
+                _async_sem = asyncio.Semaphore(limit)
+    return _async_sem
+
+
+def _record(status: int) -> None:
+    with _stats_lock:
+        _stats["total"] += 1
+        if status == 429:
+            _stats["429"] += 1
+        elif status >= 500:
+            _stats["5xx"] += 1
+        now = time.monotonic()
+        # Log at most once every 30 seconds, only when there was flakiness.
+        if (
+            now - _stats["last_log_ts"] > 30.0
+            and (_stats["429"] + _stats["5xx"]) > 0
+        ):
+            _log.warning(
+                "LLM gateway: %d reqs, 429=%d (%.1f%%), 5xx=%d (%.1f%%)",
+                _stats["total"],
+                _stats["429"],
+                100 * _stats["429"] / max(_stats["total"], 1),
+                _stats["5xx"],
+                100 * _stats["5xx"] / max(_stats["total"], 1),
+            )
+            _stats["last_log_ts"] = now
+
+
+class _ThrottledAsyncTransport(httpx.AsyncHTTPTransport):
+    """httpx async transport that throttles concurrent outbound requests.
+
+    Retries are intentionally not done here; the openai SDK does that with
+    proper ``Retry-After`` handling. Layering a second retry loop here would
+    double the backoff window and fight with the SDK's budget accounting.
+    """
+
+    def __init__(self, max_concurrency: int, **kwargs) -> None:
+        super().__init__(**kwargs)
+        self._max_concurrency = max_concurrency
+
+    async def handle_async_request(self, request):  # type: ignore[override]
+        _rewrite_request_body_for_yunwu(request)
+        sem = _get_async_sem(self._max_concurrency)
+        async with sem:
+            response = await super().handle_async_request(request)
+        _record(response.status_code)
+        return response
+
+
+class _ThrottledSyncTransport(httpx.HTTPTransport):
+    def __init__(self, max_concurrency: int, **kwargs) -> None:
+        super().__init__(**kwargs)
+        global _sync_sem
+        if _sync_sem is None:
+            _sync_sem = threading.Semaphore(max_concurrency)
+
+    def handle_request(self, request):  # type: ignore[override]
+        _rewrite_request_body_for_yunwu(request)
+        assert _sync_sem is not None
+        with _sync_sem:
+            response = super().handle_request(request)
+        _record(response.status_code)
+        return response
+
+
+def _httpx_timeout(read_s: float) -> httpx.Timeout:
+    # connect/write short; read long (LLMs with thinking can take minutes).
+    return httpx.Timeout(connect=15.0, read=read_s, write=30.0, pool=15.0)
+
+
+def _patch_openai_defaults(
+    base_url: str,
+    api_key: str,
+    max_retries: int,
+    max_concurrency: int,
+    timeout: httpx.Timeout,
+) -> None:
+    """Redirect bare ``OpenAI()`` / ``AsyncOpenAI()`` constructions.
+
+    Scenesmith calls these with no kwargs (see ``vlm_service.py``,
+    ``image_generation.py``, ``turn_trimming_session.py``,
+    ``robot_eval/llm_utils.py``). We inject sane defaults without breaking
+    call sites that do pass explicit args.
+    """
+    import openai as _openai
+
+    _orig_sync = _openai.OpenAI.__init__
+    _orig_async = _openai.AsyncOpenAI.__init__
+
+    def _sync_init(self, *args, **kwargs):
+        kwargs.setdefault("base_url", base_url)
+        kwargs.setdefault("api_key", api_key)
+        kwargs.setdefault("max_retries", max_retries)
+        kwargs.setdefault("timeout", timeout)
+        kwargs.setdefault(
+            "http_client",
+            httpx.Client(
+                transport=_ThrottledSyncTransport(max_concurrency=max_concurrency),
+                timeout=timeout,
+            ),
+        )
+        _orig_sync(self, *args, **kwargs)
+
+    def _async_init(self, *args, **kwargs):
+        kwargs.setdefault("base_url", base_url)
+        kwargs.setdefault("api_key", api_key)
+        kwargs.setdefault("max_retries", max_retries)
+        kwargs.setdefault("timeout", timeout)
+        kwargs.setdefault(
+            "http_client",
+            httpx.AsyncClient(
+                transport=_ThrottledAsyncTransport(max_concurrency=max_concurrency),
+                timeout=timeout,
+            ),
+        )
+        _orig_async(self, *args, **kwargs)
+
+    _openai.OpenAI.__init__ = _sync_init  # type: ignore[assignment]
+    _openai.AsyncOpenAI.__init__ = _async_init  # type: ignore[assignment]
+
+
+def _patch_agents_sdk(
+    base_url: str,
+    api_key: str,
+    mode: str,
+    max_retries: int,
+    max_concurrency: int,
+    timeout: httpx.Timeout,
+    disable_tracing: bool,
+) -> None:
+    """Install the default client used by ``openai-agents`` Agent runs."""
+    from openai import AsyncOpenAI
+
+    try:
+        from agents import (
+            set_default_openai_api,
+            set_default_openai_client,
+            set_tracing_disabled,
+        )
+    except ImportError:  # pragma: no cover - SDK not installed
+        _log.warning(
+            "openai-agents SDK not importable; skipping agents-side patch"
+        )
+        return
+
+    agents_client = AsyncOpenAI(
+        base_url=base_url,
+        api_key=api_key,
+        max_retries=max_retries,
+        timeout=timeout,
+        http_client=httpx.AsyncClient(
+            transport=_ThrottledAsyncTransport(max_concurrency=max_concurrency),
+            timeout=timeout,
+        ),
+    )
+    # use_for_tracing=False: the gateway doesn't implement trace upload.
+    set_default_openai_client(agents_client, use_for_tracing=False)
+    set_default_openai_api(mode)  # "responses" or "chat_completions"
+    if disable_tracing:
+        # set_tracing_disabled(True) triggers lazy construction of the SDK's
+        # default trace exporter (a BackendSpanExporter that spins up an
+        # httpx.Client reading the process's proxy env vars). On boxes with a
+        # SOCKS proxy but no socksio installed, that constructor raises
+        # ImportError. Pre-seed the exporter with a no-op so the real one is
+        # never instantiated -- tracing is disabled anyway, so nothing runs.
+        try:
+            from agents.tracing import processors as _trace_processors
+
+            if _trace_processors._global_exporter is None:
+                _trace_processors._global_exporter = (
+                    _trace_processors.ConsoleSpanExporter()
+                )
+        except Exception:  # noqa: BLE001 - best-effort pre-seed
+            pass
+        set_tracing_disabled(True)
+
+
+def _patch_vlm_reasoning_set(extra: set[str]) -> None:
+    """Expand the reasoning-model set so VLMService routes to Responses API."""
+    from scenesmith.agent_utils import vlm_service as _vlm
+
+    _orig = _vlm.VLMService.__init__
+
+    def _patched(self, *args, **kwargs):
+        _orig(self, *args, **kwargs)
+        self._reasoning_models = self._reasoning_models | extra
+
+    _vlm.VLMService.__init__ = _patched  # type: ignore[assignment]
+
+
+def _patch_torch_hub_offline() -> None:
+    """Make ``torch.hub.load(..., source="github")`` fully offline when the
+    repo is already cached on disk.
+
+    Background: on networks where GitHub connections flap, torch.hub's default
+    behaviour can hit ``RemoteDisconnected`` during a repo-freshness check
+    even when ``force_reload=False`` and the repo directory is complete. The
+    geometry-generation workers then die at SAM3D preload (``dinov2`` fetch),
+    and worker_pool restart enters a crash loop because by that point the
+    parent process has already initialised CUDA via the in-thread CLIP
+    retrieval server.
+
+    We monkey-patch once, early, so every subsequent ``torch.hub.load`` call
+    that names a GitHub repo whose snapshot already exists in
+    ``~/.cache/torch/hub/<user>_<repo>_<ref>/`` transparently redirects to
+    ``source="local"`` with the cached path. ``trust_repo=True`` is injected
+    for the fallback github path, so the two-step trust prompt never blocks.
+    """
+    try:
+        import torch.hub as _hub
+    except ImportError:  # pragma: no cover - should not happen in container
+        return
+
+    _orig_load = _hub.load
+    # torch.hub.get_dir() already ends in "/hub" (it's TORCH_HOME/hub). Don't
+    # append "hub" again or we'd end up looking at a non-existent directory
+    # and silently fall back to network fetch.
+    hub_root = _hub.get_dir()
+
+    def _resolve_cached_dir(repo_or_dir: str) -> str | None:
+        if "/" not in repo_or_dir:
+            return None
+        user, _, rest = repo_or_dir.partition("/")
+        # torch.hub's cache directory naming: <user>_<repo>_<ref>
+        # Default ref is 'main'; repo_or_dir may be 'user/repo' or
+        # 'user/repo:ref'.
+        repo, _, ref = rest.partition(":")
+        ref = ref or "main"
+        candidate = os.path.join(hub_root, f"{user}_{repo}_{ref}")
+        return candidate if os.path.isdir(candidate) else None
+
+    def _patched_load(repo_or_dir, *args, source="github", **kwargs):
+        if source == "github":
+            cached = _resolve_cached_dir(repo_or_dir)
+            if cached is not None:
+                _log.info(
+                    "torch.hub: serving %s from local cache %s (network skipped)",
+                    repo_or_dir,
+                    cached,
+                )
+                return _orig_load(cached, *args, source="local", **kwargs)
+            # Repo not cached -- let torch.hub download, but never prompt.
+            kwargs.setdefault("trust_repo", True)
+        return _orig_load(repo_or_dir, *args, source=source, **kwargs)
+
+    _hub.load = _patched_load  # type: ignore[assignment]
+
+
+@lru_cache(maxsize=1)
+def configure() -> bool:
+    """Apply gateway redirection. Idempotent, no-op if not enabled.
+
+    Returns:
+        True if configured, False otherwise.
+    """
+    base_url = os.environ.get("SCENESMITH_LLM_BASE_URL")
+    if not base_url:
+        return False
+
+    api_key = (
+        os.environ.get("SCENESMITH_LLM_API_KEY")
+        or os.environ.get("OPENAI_API_KEY")
+    )
+    if not api_key:
+        raise RuntimeError(
+            "SCENESMITH_LLM_BASE_URL is set but neither SCENESMITH_LLM_API_KEY "
+            "nor OPENAI_API_KEY is available"
+        )
+
+    mode = os.environ.get("SCENESMITH_LLM_MODE", "responses").strip()
+    if mode not in {"responses", "chat_completions"}:
+        raise ValueError(
+            f"SCENESMITH_LLM_MODE must be 'responses' or 'chat_completions', "
+            f"got {mode!r}"
+        )
+
+    max_retries = int(os.environ.get("SCENESMITH_LLM_MAX_RETRIES", "10"))
+    max_concurrency = int(os.environ.get("SCENESMITH_LLM_MAX_CONCURRENCY", "8"))
+    read_timeout = float(os.environ.get("SCENESMITH_LLM_TIMEOUT_READ", "180"))
+    disable_tracing = (
+        os.environ.get("SCENESMITH_LLM_DISABLE_TRACING", "1").strip() != "0"
+    )
+    extra_reasoning = {
+        m.strip()
+        for m in os.environ.get("SCENESMITH_LLM_REASONING_MODELS", "").split(",")
+        if m.strip()
+    }
+
+    global _strip_tool_choice
+    _strip_tool_choice = (
+        os.environ.get("SCENESMITH_LLM_STRIP_TOOL_CHOICE", "1").strip() != "0"
+    )
+
+    timeout = _httpx_timeout(read_timeout)
+
+    # Also update these so anything that sidesteps the openai SDK and reads env
+    # directly still hits the gateway.
+    os.environ["OPENAI_BASE_URL"] = base_url
+    os.environ["OPENAI_API_KEY"] = api_key
+
+    _patch_openai_defaults(
+        base_url=base_url,
+        api_key=api_key,
+        max_retries=max_retries,
+        max_concurrency=max_concurrency,
+        timeout=timeout,
+    )
+    _patch_agents_sdk(
+        base_url=base_url,
+        api_key=api_key,
+        mode=mode,
+        max_retries=max_retries,
+        max_concurrency=max_concurrency,
+        timeout=timeout,
+        disable_tracing=disable_tracing,
+    )
+    if extra_reasoning:
+        _patch_vlm_reasoning_set(extra_reasoning)
+
+    # Always-on: redirect torch.hub.load to local cache when possible so
+    # geometry-gen workers don't die on transient GitHub flakes.
+    _patch_torch_hub_offline()
+
+    _log.info(
+        "LLM gateway configured: base=%s mode=%s max_retries=%d "
+        "max_concurrency=%d read_timeout=%.0fs tracing=%s extra_reasoning=%s "
+        "strip_tool_choice=%s",
+        base_url,
+        mode,
+        max_retries,
+        max_concurrency,
+        read_timeout,
+        "off" if disable_tracing else "on",
+        sorted(extra_reasoning) or "-",
+        _strip_tool_choice,
+    )
+    return True
+
+
+def stats() -> dict[str, int | float]:
+    """Snapshot of 429/5xx counters for external monitoring."""
+    with _stats_lock:
+        return dict(_stats)
